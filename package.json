{
  "name": "tideglyph",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "A calm field notebook board for coastal research teams.",
  "author": "amr1mandouh <amr1mandouh@gmail.com>",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite --config vite.config.mjs build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vite.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "repository": { "type": "git", "url": "https://github.com/amr1mandouh/tideglyph" },
  "bugs": { "url": "https://github.com/amr1mandouh/tideglyph/issues" },
  "homepage": "https://github.com/amr1mandouh/tideglyph#readme",
  "dependencies": { "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
